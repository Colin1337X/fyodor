+            c->function_get(&add,c->module,"nya_add_q6_large") == CUDA_SUCCESS) {
+            c->dot[14] = dot;
+            c->integer_q6_add = add;
+        }
+    }
 #endif
     if (!training) {
     nya_blas_open(c);
