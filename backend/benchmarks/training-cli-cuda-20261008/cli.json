[
  {
    "name": "cli-configure",
    "command": [
      "cmake",
      "-S",
      "backend",
      "-B",
      "build-cuda"
    ],
    "exit_code": 0
  },
  {
    "name": "cli-build",
    "command": [
      "cmake",
      "--build",
      "build-cuda",
      "--target",
      "fyodor-train",
      "--parallel",
      "6"
    ],
    "exit_code": 0
  },
  {
    "name": "cli-gpu-tests",
    "command": [
      "ctest",
      "--test-dir",
      "build-cuda",
      "-R",
      "train-cuda-|train-evaluation|train-stop-workflows",
      "--output-on-failure"
    ],
    "exit_code": 8
  }
]
