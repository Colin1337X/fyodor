 /* Run prompt ingestion followed by bounded autoregressive generation. */
+/* Opt-in wall time for the complete decode loop, including sampling, host
+   assistant work and transfers. Prefill and teardown are excluded. The first
+   output uses prefill logits, so this is not the fixed-token bench contract. */
+static void nya_llm_decode_profile(const char *mode, uint64_t start, size_t prompt, size_t generated)
+{
+    uint64_t end = nya_runtime_monotonic_milliseconds();
+    fprintf(stderr, "Generation profile: mode=%s prompt=%zu generated=%zu decode_loop_ms=%llu\n",
+        mode, prompt, generated, (unsigned long long)(end >= start ? end - start : 0));
+}
