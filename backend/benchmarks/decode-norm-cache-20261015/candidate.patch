+/* Fixed-width F32 decode RMSNorm keeps inputs in registers across the
+   unchanged ordered sum and warp reduction. Generic formats retain nya_norm. */
+extern "C" __global__ void nya_norm_f32_2048(const float *x, float *out,
+    const unsigned char *w, unsigned long long n, unsigned type, float epsilon)
+{
+    float values[8], sum = 0;
+    #pragma unroll
+    for (unsigned j = 0; j < 8; ++j) {
+        values[j] = x[threadIdx.x+j*256];
+        sum += values[j]*values[j];
+    }
+    sum = nya_sum(sum);
+    __shared__ float scale;
+    if (!threadIdx.x) scale = rsqrtf(sum/2048.0f+epsilon);
+    __syncthreads();
+    #pragma unroll
+    for (unsigned j = 0; j < 8; ++j) {
+        unsigned i = threadIdx.x+j*256;
+        out[i] = values[j]*scale*(w ? ((const float *)w)[i] : 1.0f);
+    }
+}
+
+extern "C" __global__ void nya_norm_f32_4096(const float *x, float *out,
+    const unsigned char *w, unsigned long long n, unsigned type, float epsilon)
+{
+    float values[16], sum = 0;
+    #pragma unroll
+    for (unsigned j = 0; j < 16; ++j) {
+        values[j] = x[threadIdx.x+j*256];
+        sum += values[j]*values[j];
+    }
+    sum = nya_sum(sum);
+    __shared__ float scale;
+    if (!threadIdx.x) scale = rsqrtf(sum/4096.0f+epsilon);
+    __syncthreads();
+    #pragma unroll
+    for (unsigned j = 0; j < 16; ++j) {
+        unsigned i = threadIdx.x+j*256;
+        out[i] = values[j]*scale*(w ? ((const float *)w)[i] : 1.0f);
+    }
+}
+
+extern "C" __global__ void nya_norm_f32_8192(const float *x, float *out,
+    const unsigned char *w, unsigned long long n, unsigned type, float epsilon)
+{
+    float values[32], sum = 0;
+    #pragma unroll
+    for (unsigned j = 0; j < 32; ++j) {
+        values[j] = x[threadIdx.x+j*256];
+        sum += values[j]*values[j];
+    }
+    sum = nya_sum(sum);
+    __shared__ float scale;
+    if (!threadIdx.x) scale = rsqrtf(sum/8192.0f+epsilon);
+    __syncthreads();
+    #pragma unroll
+    for (unsigned j = 0; j < 32; ++j) {
+        unsigned i = threadIdx.x+j*256;
+        out[i] = values[j]*scale*(w ? ((const float *)w)[i] : 1.0f);
+    }
+}
