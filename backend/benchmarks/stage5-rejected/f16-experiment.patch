+/* Compare Gemma's mixed head widths, local attention and shared-KV producers
+   with explicit half-cache semantics. Existing F32/autograd goldens stay intact.
+   A simultaneous F32 session on the same context catches precision leakage. */
+static int check_gemma_half_sessions(nya_llm_context *c)
+{
+    char error[256] = {0};
+    nya_llm_context cpu = *c; cpu.compute = NULL;
+    nya_llm_session *half = nya_llm_session_create_kv(c,8,NYA_KV_F16,error,sizeof(error));
+    nya_llm_session *reference = nya_llm_session_create_kv(&cpu,8,NYA_KV_F16,error,sizeof(error));
+    nya_llm_session *other = nya_llm_session_create(c,8,error,sizeof(error));
+    int result = -1;
+    const uint32_t tokens[] = {1,3,4,5,2,6,7,1};
+    if (!half || !reference || !other) goto done;
+    for (unsigned pass = 0; pass < 3; ++pass) {
+        nya_llm_session_reset(half); nya_llm_session_reset(reference); nya_llm_session_reset(other);
+        for (size_t pos = 0; pos < 8;) {
+            size_t chunk = pass && pos == 0 ? 3 : 1;
+            if (nya_llm_session_run(other,tokens+pos,chunk,0) ||
+                nya_llm_session_run(half,tokens+pos,chunk,0) ||
+                nya_llm_session_run(reference,tokens+pos,chunk,1)) goto done;
+            const float *a = nya_llm_session_logits(half), *b = nya_llm_session_logits(reference);
+            for (size_t j = 0; j < 8; ++j) if (!isfinite(a[j]) || fabs((double)a[j]-b[j]) > 3e-5) {
+                fprintf(stderr,"Gemma F16 cache pass %u position %zu logit %zu: %.9g vs %.9g\n",pass,pos,j,(double)a[j],(double)b[j]); goto done;
+            }
+            pos += chunk;
+        }
+        nya_compute_stats a,b;
+        nya_llm_session_stats(half,&a); nya_llm_session_stats(other,&b);
+        if (a.kv_type != NYA_KV_F16 || b.kv_type != NYA_KV_F32 || c->inference_kv_type != NYA_KV_F32) goto done;
+        if (getenv("NYA_TEST_GRAPH") && (!strcmp(nya_llm_session_execution(half),"resident")) && a.graph_captures != 1) goto done;
+    }
+    result = 0;
+done:
+    nya_llm_session_free(half); nya_llm_session_free(reference); nya_llm_session_free(other);
