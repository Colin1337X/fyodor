execute_process(COMMAND "${PROGRAM}" --profile-shapes
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE diagnostics TIMEOUT 150)
if(result STREQUAL "77")
    message("CUDA profile fixture unavailable")
    return()
endif()
if(NOT result STREQUAL "0")
    message(FATAL_ERROR "Profile fixture failed (${result}): ${output}\n${diagnostics}")
endif()
string(REGEX MATCHALL "train_profile_matrix timing=[^\n]+" rows "${diagnostics}")
list(LENGTH rows count)
if(NOT count EQUAL 64)
    message(FATAL_ERROR "Expected 63 matrix shapes plus overflow; got ${count}")
endif()
set(total 0)
set(overflow_count 0)
foreach(row IN LISTS rows)
    if(NOT row MATCHES "forward_calls=([0-9]+) ")
        message(FATAL_ERROR "Missing call count: ${row}")
    endif()
    set(calls "${CMAKE_MATCH_1}")
    math(EXPR total "${total}+${calls}")
    if(row MATCHES "overflow=1 ")
        math(EXPR overflow_count "${overflow_count}+1")
        if(NOT calls EQUAL 14)
            message(FATAL_ERROR "Expected 14 overflow calls: ${row}")
        endif()
    elseif(NOT calls EQUAL 2)
        message(FATAL_ERROR "Existing shape was not reused: ${row}")
    endif()
endforeach()
if(NOT total EQUAL 140 OR NOT overflow_count EQUAL 1)
    message(FATAL_ERROR "Matrix calls lost or overflow duplicated")
endif()
message("Verified 140 calls, 63 repeated shapes and one overflow bucket")
