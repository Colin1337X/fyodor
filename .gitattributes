# Preserve the exact bytes of measured results and diagnostic transcripts.
# Long raw logs remain readable as files without producing noisy textual diffs.
backend/benchmarks/**/*.json -text whitespace=cr-at-eol
backend/benchmarks/**/*.log -text -diff
backend/benchmarks/**/*.out -text -diff
backend/benchmarks/**/*.patch -text -diff
backend/benchmarks/stage*-validation/*.py -text whitespace=cr-at-eol,-blank-at-eof
# Benchmark corpora and profiler output are byte-exact evidence, including
# intentional terminal spaces. Do not rewrite their recorded input hashes.
backend/benchmarks/training-*/**/corpus.txt -text whitespace=-blank-at-eol
backend/benchmarks/training-*/corpus.txt -text whitespace=-blank-at-eol
backend/benchmarks/training-20260923/before-gprof.txt -text -diff
# Preserve raw nvidia-smi process snapshots, including terminal padding.
backend/benchmarks/inference-20260925/**/processes*.txt -text -diff
backend/benchmarks/inference-20260925/**/contamination-processes.txt -text -diff
backend/benchmarks/inference-20260926/**/processes*.txt -text -diff
backend/benchmarks/inference-matrix-profile-20260926/**/processes*.txt -text -diff
